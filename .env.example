# ==============================================================================
# ROZIYEVDEV — PRODUCTION ATROF-MUHIT SOZLAMALARI (.env)
# Ushbu faylni .env nomi bilan nusxalang va o'z server parametrlaringizni kiriting:
# cp .env.example .env
# ==============================================================================

# 1. ASOSIY DJANGO SOZLAMALARI
# Xavfsiz, tasodifiy uzun kalit yarating (masalan: python -c "import secrets; print(secrets.token_urlsafe(50))")
DJANGO_SECRET_KEY=ozingizning-juda-maxfiy-va-uzun-kalitingizni-bu-yerga-yozing-kamida-50-belgi

# Production rejimida ALBATTA False bo'lishi shart!
DJANGO_DEBUG=False

# Server domeni va IP manzili (vergul bilan ajratilgan)
DJANGO_ALLOWED_HOSTS=roziyev.dev,www.roziyev.dev,127.0.0.1,localhost

# CSRF xavfsizligi uchun ruxsat etilgan domenlar (https:// bilan)
DJANGO_CSRF_TRUSTED_ORIGINS=https://roziyev.dev,https://www.roziyev.dev

# Saytning asosiy manzili
SITE_URL=https://roziyev.dev

# Nginx ortida ishlaganda haqiqiy mijoz IP manzilini olish
USE_X_REAL_IP=True

# 2. MA'LUMOTLAR BAZASI (PostgreSQL tavsiya etiladi)
# Format: postgres://foydalanuvchi:parol@host:port/baza_nomi
DATABASE_URL=postgres://roziyev_user:kuchli_parol_123@localhost:5432/roziyev_db

# Kichik hajm uchun SQLite ishlatmoqchi bo'lsangiz DATABASE_URL ni bo'sh qoldiring yoki o'chiring.

# 3. KESH VA SEANSIYALAR (Redis tavsiya etiladi)
REDIS_URL=redis://127.0.0.1:6379/1

# 4. FAYL VA VIDEO YUKLASH CHEKLOVLARI (Baytlarda)
# 500 MB gacha video va materiallar yuklash uchun:
DATA_UPLOAD_MAX_MEMORY_SIZE=524288000
FILE_UPLOAD_MAX_MEMORY_SIZE=52428800

# 5. ELEKTRON POCHTA (SMTP — Google Workspace, Yandex, Mailgun yoki SendGrid)
DEFAULT_FROM_EMAIL=RoziyevDev <no-reply@roziyev.dev>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=sizning_pochta@gmail.com
EMAIL_HOST_PASSWORD=sizning_app_password
EMAIL_USE_TLS=True

# 6. TO'LOV TIZIMLARI INTEGRATSIYASI (Click & Payme)
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_TEST_MODE=False

CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=

# Haqiqiy pul to'lovsiz demo sinov rejimini o'chirish (productionda False bo'ladi)
PAYMENTS_DEMO_ENABLED=False

# 7. TELEGRAM BILDIRISHNOMALARI (Ixtiyoriy)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# 8. HTTPS VA PRODUCTION XAVFSIZLIK SOZLAMALARI
# SSL sertifikati (Let's Encrypt / Certbot) o'rnatilgach True qilinadi:
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_COOKIES=True
DJANGO_HSTS_SECONDS=31536000
DJANGO_X_FRAME_OPTIONS=SAMEORIGIN

# 9. LOG DARALARI (INFO, WARNING, ERROR)
LOG_LEVEL=INFO
